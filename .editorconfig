root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{c,h,cpp,hpp,cc,cxx}]
indent_style = space
indent_size = 4

[*.{java}]
indent_style = space
indent_size = 4

[*.{go}]
indent_style = tab
indent_size = 4

[*.{rs}]
indent_style = space
indent_size = 4

[*.{ts,js,json}]
indent_style = space
indent_size = 2

[*.{md,rst,txt}]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_style = space
indent_size = 2

[Makefile]
indent_style = tab
indent_size = 4

[CMakeLists.txt]
indent_style = space
indent_size = 2

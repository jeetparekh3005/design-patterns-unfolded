{
  "name": "design-patterns-unfolded",
  "version": "1.0.0",
  "description": "Cross-language, storytelling-driven exploration of software design patterns",
  "private": true,
  "workspaces": [
    "patterns/*/implementations/typescript"
  ],
  "scripts": {
    "setup": "./scripts/setup.sh",
    "build": "./scripts/build-all.sh",
    "test": "./scripts/test-all.sh",
    "lint": "find . -name '*.ts' -o -name '*.js' | xargs eslint",
    "format": "prettier --write '**/*.{ts,js,json,md}'",
    "docs:build": "mkdocs build",
    "docs:serve": "mkdocs serve"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^25.2.0",
    "eslint": "^9.37.0",
    "jest": "^30.2.0",
    "prettier": "^3.8.3",
    "ts-jest": "^29.1.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/your-username/design-patterns-unfolded.git"
  },
  "keywords": [
    "design-patterns",
    "software-architecture",
    "programming-languages",
    "education",
    "storytelling",
    "c",
    "cpp",
    "go",
    "typescript",
    "java",
    "rust"
  ],
  "author": "Design Patterns Unfolded Team",
  "license": "MIT"
}
